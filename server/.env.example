# ==========================================
# Resume Builder Backend Configuration
# ==========================================

# Server Environment
PORT=5000
NODE_ENV=production

# Database Connection (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/resume-builder?retryWrites=true&w=majority

# Authentication Security (Cryptographically secure string)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long

# CORS Allowed Client Origin (e.g. your Vercel or custom domain)
CLIENT_URL=http://localhost:5173

# Google Gemini AI API Key (Get from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary Storage for Profile Images (Optional - falls back to local disk storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email SMTP Delivery for 6-Digit OTP (Optional - logs to console if omitted)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Resume Builder" <noreply@yourdomain.com>
